# ─────────────────────────────────────────────────────────────────────────────
# Tarot Dinatoire — Environment Variables Reference
# Copy this file to .env and fill in the actual values.
# NEVER commit the real .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# Lovable Cloud / Supabase project ID (publishable — safe for client)
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"

# Lovable Cloud anonymous key (publishable — safe for client)
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"

# Lovable Cloud API URL (publishable — safe for client)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Sentry DSN for error monitoring (optional — safe for client)
# VITE_SENTRY_DSN="https://xxxx@sentry.io/xxxx"

# ─────────────────────────────────────────────────────────────────────────────
# EDGE FUNCTION SECRETS — stored server-side only, NEVER in .env client file
# Set these via Lovable Cloud secrets manager (not in this file):
#   TAROT_API_KEY          — Lovable AI API key
#   LOVABLE_API_KEY        — Lovable platform key
#   STRIPE_SECRET_KEY      — Stripe secret key
#   STRIPE_WEBHOOK_SECRET  — Stripe webhook signing secret
#   ELEVENLABS_API_KEY     — ElevenLabs TTS API key
#   WORKER_SECRET          — Agent worker authentication secret
#   ADMIN_BOOTSTRAP_TOKEN  — One-time admin activation token
#   ADMIN_BOOTSTRAP_EMAIL  — Email authorized for admin bootstrap
# ─────────────────────────────────────────────────────────────────────────────
